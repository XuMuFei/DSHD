{
    "name": "dshd",
    "version": "1.2.2",
    "description": "Windows desktop client for DeepSeek Harness Web",
    "author": "DeepSeek",
    "private": true,
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win nsis --config.directories.output=release",
        "dist:mac": "electron-builder --mac dmg --config.directories.output=release",
        "dist:dir": "electron-builder --win dir"
    },
    "devDependencies": {
        "electron": "^37.2.6",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "ai.deepseek.dshd",
        "productName": "DSHD",
        "electronDist": "node_modules/electron/dist",
        "asar": true,
        "files": [
            "main.js",
            "preload.js",
            "renderer.js",
            "shell.css",
            "shell.html",
            "package.json",
            "lib/**",
            "build/icon.png"
        ],
        "mac": {
            "icon": "build/icons/mac/icon.icns",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools"
        },
        "dmg": {
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "allowScripts": {
        "electron@37.10.3": true
    }
}
