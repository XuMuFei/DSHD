{
    "name": "dshd",
    "version": "1.2.1",
    "description": "Windows desktop client for DeepSeek Harness Web",
    "author": "DeepSeek",
    "private": true,
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win nsis --config.directories.output=release",
        "dist:dir": "electron-builder --win dir"
    },
    "devDependencies": {
        "electron": "^37.2.6",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "ai.deepseek.dshd",
        "productName": "DSHD",
        "electronDist": "node_modules/electron/dist",
        "asar": true,
        "files": [
            "main.js",
            "preload.js",
            "renderer.js",
            "shell.css",
            "shell.html",
            "package.json",
            "lib/**",
            "build/icon.png"
        ],
        "win": {
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "allowScripts": {
        "electron@37.10.3": true
    }
}
