{
    "name": "dshd",
    "version": "2.0.3",
    "description": "Windows desktop client for DeepSeek Harness Web",
    "author": "DeepSeek",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "build:ts": "tsc",
        "build:ts:watch": "tsc --watch",
        "copy:static": "node scripts/copy-static.js",
        "build": "npm run build:ts && npm run copy:static",
        "start": "npm run build && electron .",
        "dist": "npm run build && electron-builder --win nsis --config.directories.output=release",
        "dist:mac": "npm run build && electron-builder --mac dmg --config.directories.output=release",
        "dist:dir": "npm run build && electron-builder --win dir",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "electron": "^37.2.6",
        "electron-builder": "^26.0.12",
        "typescript": "^5.4.0"
    },
    "build": {
        "appId": "ai.deepseek.dshd",
        "productName": "DSHD",
        "electronDist": "node_modules/electron/dist",
        "asar": true,
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "mac": {
            "icon": "build/icons/mac/icon.icns",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools"
        },
        "dmg": {
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "allowScripts": {
        "electron@37.10.3": true
    },
    "dependencies": {
        "glob": "^13.0.6"
    }
}
